{
  "name": "@lead-routing/cli",
  "version": "0.8.3",
  "description": "Self-hosted deployment CLI for Lead Routing",
  "homepage": "https://github.com/lead-routing/lead-routing",
  "keywords": [
    "salesforce",
    "lead-routing",
    "self-hosted",
    "deployment",
    "cli"
  ],
  "type": "module",
  "bin": {
    "lead-routing": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "node -e \"const{cpSync,existsSync,rmSync}=require('fs');const src='../../sfdc-package';if(existsSync(src)){rmSync('sfdc-package',{recursive:true,force:true});cpSync(src,'sfdc-package',{recursive:true})}\"",
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@prisma/client": "^6.5.0",
    "archiver": "^7.0.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "node-ssh": "^13.2.1",
    "prisma": "^6.5.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3"
  }
}
