{
  "name": "@lead-routing/mcp",
  "version": "0.2.0",
  "description": "MCP server for Lead Routing — route leads, manage rules and teams from Claude Code",
  "type": "module",
  "bin": {
    "lead-routing-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
