generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum CrmType {
  SALESFORCE
  HUBSPOT
}

enum CrmObjectType {
  LEAD
  CONTACT
  ACCOUNT
  COMPANY
  DEAL
  USER
}

enum SlaMetCriteria {
  ANY_ACTIVITY        // notes_last_contacted changed
  STATUS_CHANGE       // hs_lead_status changed from initial value
  SPECIFIC_STATUS     // hs_lead_status reaches a target value
  MEETING_BOOKED      // engagements_last_meeting_booked changed
}

enum SlaInstanceStatus {
  ACTIVE              // Timer running
  MET                 // Rep took action in time
  BREACHED            // Timer expired, breach actions executed
  ESCALATED           // Max re-routes exceeded, needs manual attention
  CANCELLED           // Record re-routed manually or deleted
}

enum TriggerEvent {
  INSERT
  UPDATE
  BOTH
  SEARCH
}

enum RouteType {
  REALTIME
  SCHEDULED
}

enum RuleStatus {
  ACTIVE
  INACTIVE
}

enum AssignmentType {
  USER
  ROUND_ROBIN
  QUEUE
}

enum TeamMemberStatus {
  ACTIVE
  PAUSED
}

enum RoutingStatus {
  SUCCESS
  FAILED
  UNMATCHED
  RETRY
  MERGED
  COOLDOWN_SKIPPED
  STAMP_SKIPPED
}

enum LeadMatchAction {
  SFDC_MERGE
  ASSIGN_TO_OWNER
  ASSIGN_CUSTOM
}

enum ContactMatchAction {
  ASSIGN_TO_OWNER
  ASSIGN_CUSTOM
  SKIP
}

enum AccountMatchAction {
  ASSIGN_TO_OWNER
  ASSIGN_CUSTOM
  SKIP
}

enum Plan {
  FREE
  PAID
}

enum FlowStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum FlowNodeType {
  ENTRY
  DECISION
  BRANCH_DECISION
  MATCH
  ASSIGNMENT
  UPDATE_FIELD
  CREATE_TASK
  FILTER
  DEFAULT
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Organization {
  id                String   @id @default(cuid())
  crmType           CrmType? // null until CRM connected
  sfdcOrgId         String?  @unique   // null until CRM is connected in onboarding
  sfdcInstanceUrl   String?            // null until CRM is connected
  oauthAccessToken  String?            // null until CRM is connected
  oauthRefreshToken String?            // null until CRM is connected
  webhookSecret     String   // HMAC secret for verifying Apex trigger payloads
  // HubSpot-specific fields
  hubspotPortalId   String?  @unique   // null until HubSpot connected
  hubspotAppId      String?            // HubSpot developer app ID
  hubspotSubscriptionId String?        // HubSpot webhook subscription ID
  // Integration / package deploy tracking
  packageDeployedAt DateTime?
  packageDeployId   String?
  packageVersion    String?
  objectConfig      Json?              // e.g. { "Lead": { enabled: true }, "Contact": { enabled: true } }
  fieldsSyncedAt    DateTime?
  plan             Plan     @default(FREE)
  isActive         Boolean  @default(true)
  seatsPurchased    Int      @default(10)
  seatsUsed         Int      @default(0)
  routingQuotaUsed Int      @default(0)
  quotaResetAt     DateTime @default(now())
  onboardingDone           Boolean  @default(false)
  notificationWebhookUrl   String?
  // AI Assistant (Pro feature)
  aiProvider       String?   // "claude" | "openai" | "gemini" | "custom"
  aiApiKey         String?   // AES-256-GCM encrypted
  aiModelName      String?   // e.g. "claude-sonnet-4-5-20250514", "gpt-4o"
  aiBaseUrl        String?   // custom endpoint URL (null = default)
  aiCustomHeaders  Json?     // custom headers for self-hosted proxies
  aiChatCount      Int       @default(0)
  // License activation (from web UI)
  licenseKey         String?
  licenseTier        String?   // "free" | "pro"
  licenseValidUntil  DateTime?
  licenseActivatedAt DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  users        User[]
  appUsers     AppUser[]
  invites      Invite[]
  teams        RoundRobinTeam[]
  routingRules RoutingRule[]
  routingLogs  RoutingLog[]
  auditLogs    AuditLog[]
  sfdcQueues   SfdcQueue[]
  fieldSchemas FieldSchema[]
  billingInfo             BillingInfo?
  routingDailyAggregates  RoutingDailyAggregate[]
  conversionTracking      ConversionTracking[]
  companyAliases          CompanyAlias[]
  bulkSearchRuns          BulkSearchRun[]
  aiCustomPrompts         AiCustomPrompt[]
  aiAgentLogs             AiAgentLog[]
  aiChatFeedback          AiChatFeedback[]
  routingMode             Json?
  routingFlows            RoutingFlow[]
  apiTokens               ApiToken[]
  slaPolicies             SlaPolicy[]
  slaInstances            SlaInstance[]
  toolCallLogs            ToolCallLog[]

  @@map("organizations")
}

model AppUser {
  id           String   @id @default(cuid())
  orgId        String
  email        String
  name         String
  passwordHash String   // PBKDF2: "salt:hash" (salt=16-byte hex, 310000 iterations, sha256)
  role         String   @default("ADMIN") // ADMIN | MEMBER
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@map("app_users")
}

model Invite {
  id         String    @id @default(cuid())
  orgId      String
  email      String
  token      String    @unique // 48-char hex (crypto.randomBytes(24))
  expiresAt  DateTime           // 72 hours from creation
  acceptedAt DateTime?          // null until invite is used
  createdAt  DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("invites")
}

model User {
  id           String    @id @default(cuid())
  orgId        String
  crmUserId    String    // stores SFDC user ID or HubSpot owner ID
  name         String
  email        String
  role         String?
  profile      String?
  department   String?
  isLicensed   Boolean   @default(false)
  licensedVia  String?   // "individual" | "role" | "profile" | "custom_field" — how user was licensed
  isActive     Boolean   @default(true) // false if no longer in CRM
  lastRoutedAt DateTime?
  syncedAt     DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org              Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teamMemberships  TeamMember[]
  branchAssignments RoutingBranch[] @relation("BranchAssigneeUser")
  defaultOwnerRules RoutingRule[]   @relation("DefaultOwnerUser")

  @@unique([orgId, crmUserId])
  @@map("users")
}

model RoundRobinTeam {
  id           String   @id @default(cuid())
  orgId        String
  name         String
  description      String?
  distributionType String   @default("round-robin") // "round-robin" | "weighted"
  pointerIndex     Int      @default(0) // kept in sync with Redis; Redis is authoritative
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org               Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members           TeamMember[]
  routingRules      RoutingRule[]   @relation("TeamRules")
  branchAssignments RoutingBranch[] @relation("BranchAssigneeTeam")
  defaultOwnerRules RoutingRule[]   @relation("DefaultOwnerTeam")
  slaRuleAssignments SlaRuleAssignment[]

  @@map("round_robin_teams")
}

model TeamMember {
  id              String           @id @default(cuid())
  teamId          String
  userId          String
  status          TeamMemberStatus @default(ACTIVE)
  weight          Int              @default(1) // P2 weighted round robin
  assignmentCount Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  team RoundRobinTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model RoutingRule {
  id               String          @id @default(cuid())
  orgId            String
  objectType       CrmObjectType
  triggerEvent     TriggerEvent
  name             String
  priority         Int
  status           RuleStatus      @default(ACTIVE)
  // Legacy single-assignee fields (used by old rules; null for new Route Builder rules)
  assignmentType   AssignmentType?
  assigneeUserId   String?         // references User.id (individual user)
  assigneeTeamId   String?         // references RoundRobinTeam.id
  assigneeQueueId  String?         // references SfdcQueue.id
  isDryRun         Boolean         @default(false)
  triggerName      String          @default("")
  criteriaSyncedAt DateTime?
  // Route type (real-time Apex trigger vs scheduled search)
  routeType         RouteType       @default(REALTIME)
  // Scheduled route fields
  scheduleFrequency String?         // "DAILY" | "WEEKLY" | "MONTHLY" | null (one-time)
  scheduleTime      String?         // "06:00" (24h format)
  scheduleTimezone  String?         // "UTC", "US/Eastern", etc.
  scheduleCron      String?         // computed cron expression for BullMQ
  searchCriteria    Json?           // ConditionGroup[] — search trigger criteria
  lastRunAt         DateTime?
  lastRunStatus     String?         // "SUCCESS" | "FAILED" | "PARTIAL"
  lastRunRecords    Int?            // records routed in last run
  lastRunDurationMs Int?
  totalRuns         Int             @default(0)
  totalRecordsRouted Int            @default(0)
  // Bulk search configuration
  searchMaxRecords  Int?            // user-configurable max records per run
  searchBatchSize   Int?            // micro-batch size (default 500)
  // Default owner: absolute catch-all for new Route Builder routes
  defaultOwnerType     AssignmentType?
  defaultOwnerUserId   String?
  defaultOwnerTeamId   String?
  defaultOwnerQueueId  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  org              Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team             RoundRobinTeam?  @relation("TeamRules", fields: [assigneeTeamId], references: [id])
  queue            SfdcQueue?       @relation(fields: [assigneeQueueId], references: [id])
  defaultOwnerUser  User?           @relation("DefaultOwnerUser", fields: [defaultOwnerUserId], references: [id])
  defaultOwnerTeam  RoundRobinTeam? @relation("DefaultOwnerTeam", fields: [defaultOwnerTeamId], references: [id])
  defaultOwnerQueue SfdcQueue?      @relation("DefaultOwnerQueue", fields: [defaultOwnerQueueId], references: [id])
  conditions RuleCondition[]  // legacy conditions (old-style rules)
  branches   RoutingBranch[]  // new Route Builder paths
  matchConfig RouteMatchConfig?
  triggerConditions TriggerCondition[]
  bulkSearchRuns BulkSearchRun[]
  slaRuleAssignments SlaRuleAssignment[]

  @@map("routing_rules")
}

model RoutingBranch {
  id              String         @id @default(cuid())
  ruleId          String
  rule            RoutingRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  label           String?
  priority        Int            @default(0)
  assignmentType  AssignmentType?
  assigneeUserId  String?
  assigneeUser    User?            @relation("BranchAssigneeUser", fields: [assigneeUserId], references: [id])
  assigneeTeamId  String?
  assigneeTeam    RoundRobinTeam?  @relation("BranchAssigneeTeam", fields: [assigneeTeamId], references: [id])
  assigneeQueueId String?
  assigneeQueue   SfdcQueue?       @relation("BranchAssigneeQueue", fields: [assigneeQueueId], references: [id])
  steps           Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  conditions  BranchCondition[]
  routingLogs RoutingLog[]
  slaRuleAssignments SlaRuleAssignment[]

  @@map("routing_branches")
}

model BranchCondition {
  id        String        @id @default(cuid())
  branchId  String
  branch    RoutingBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  groupId   String
  fieldName String
  fieldType String        @default("TEXT")
  operator  String
  value     String?
  sortOrder Int           @default(0)

  @@map("branch_conditions")
}

model TriggerCondition {
  id        String      @id @default(cuid())
  ruleId    String
  rule      RoutingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  groupId   String
  fieldName String
  fieldType String      @default("TEXT")
  operator  String
  value     String?
  sortOrder Int         @default(0)

  @@map("trigger_conditions")
}

model RouteMatchConfig {
  id              String      @id @default(cuid())
  ruleId          String      @unique
  rule            RoutingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  // Which objects to check
  checkLeads      Boolean     @default(true)
  checkContacts   Boolean     @default(true)
  checkAccounts   Boolean     @default(false)

  // Which fields to match on
  matchEmail      Boolean     @default(true)
  matchPhone      Boolean     @default(false)
  matchDomain     Boolean     @default(false)
  matchCompanyName  Boolean @default(false)
  fuzzyMatchMode    String  @default("STRICT")  // "STRICT" | "FUZZY" | "AI_SMART"

  // Lead match outcome
  onLeadMatch           LeadMatchAction    @default(SFDC_MERGE)
  leadAssignmentType    AssignmentType?
  leadAssigneeUserId    String?
  leadAssigneeTeamId    String?
  leadAssigneeQueueId   String?

  // Contact match outcome
  onContactMatch        ContactMatchAction @default(ASSIGN_TO_OWNER)
  contactAssignmentType AssignmentType?
  contactAssigneeUserId  String?
  contactAssigneeTeamId  String?
  contactAssigneeQueueId String?

  // Account match outcome
  onAccountMatch        AccountMatchAction @default(ASSIGN_TO_OWNER)
  accountAssignmentType AssignmentType?
  accountAssigneeUserId  String?
  accountAssigneeTeamId  String?
  accountAssigneeQueueId String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("route_match_configs")
}

model RuleCondition {
  id          String @id @default(cuid())
  ruleId      String
  groupId     String // conditions in same group share AND logic; groups are joined with OR
  fieldName   String // SFDC field API name (e.g., "LeadSource")
  operator    String // e.g., "equals", "contains", "gt"
  value       String? // null for is_blank / is_not_blank / is_true / is_false
  sortOrder   Int    @default(0)

  rule RoutingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@map("rule_conditions")
}

model RoutingLog {
  id             String          @id @default(cuid())
  orgId          String
  crmRecordId    String
  objectType     CrmObjectType
  eventType      TriggerEvent
  ruleId         String?
  ruleName       String?
  pathLabel      String?  // which branch/path triggered: e.g. "Path A" or "Default Owner"
  assigneeId     String?  // SFDC user/queue ID
  assigneeName   String?
  assignmentType AssignmentType?
  isDryRun        Boolean         @default(false)
  status          RoutingStatus
  errorMessage    String?
  retryCount      Int             @default(0)
  dismissed       Boolean         @default(false)
  recordSnapshot  Json?           // full field payload from SFDC at time of routing
  decisionTrace   Json?           // structured routing decision trace for Record Journey
  teamId             String?
  teamName           String?
  routingDurationMs  Int?              // ms from webhook receipt → SFDC assignment
  branchId           String?           // FK → RoutingBranch for path-level analytics
  createdAt          DateTime        @default(now())

  flowId             String?
  flowNodePath       Json?
  org                Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branch             RoutingBranch?  @relation(fields: [branchId], references: [id])
  conversionTracking ConversionTracking?
  slaInstance        SlaInstance?

  @@index([orgId, createdAt])
  @@index([orgId, status])
  @@index([orgId, teamId])
  @@index([orgId, ruleId])
  @@index([orgId, crmRecordId, createdAt])
  @@map("routing_logs")
}

model AuditLog {
  id          String   @id @default(cuid())
  orgId       String
  actorId     String   // User.id
  actorName   String
  action      String   // e.g., "USER_LICENSED", "RULE_CREATED"
  entityType  String   // e.g., "User", "RoutingRule"
  entityId    String
  beforeState Json?
  afterState  Json?
  createdAt   DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@map("audit_logs")
}

model RoutingFlow {
  id           String         @id @default(cuid())
  orgId        String
  objectType   CrmObjectType
  name         String         @default("Untitled Flow")
  status       FlowStatus     @default(DRAFT)
  triggerEvent TriggerEvent   @default(BOTH)
  isDryRun     Boolean        @default(false)
  version      Int            @default(1)
  publishedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  nodes FlowNode[]
  edges FlowEdge[]

  @@unique([orgId, objectType])
  @@map("routing_flows")
}

model FlowNode {
  id        String       @id @default(cuid())
  flowId    String
  type      FlowNodeType
  label     String?
  positionX Float        @default(0)
  positionY Float        @default(0)
  config    Json?
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  flow     RoutingFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  outEdges FlowEdge[]  @relation("FromNode")
  inEdges  FlowEdge[]  @relation("ToNode")

  @@map("flow_nodes")
}

model FlowEdge {
  id           String   @id @default(cuid())
  flowId       String
  fromId       String
  toId         String
  label        String?
  sourceHandle String?
  targetHandle String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  flow RoutingFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  from FlowNode   @relation("FromNode", fields: [fromId], references: [id], onDelete: Cascade)
  to   FlowNode   @relation("ToNode", fields: [toId], references: [id], onDelete: Cascade)

  @@map("flow_edges")
}

model SfdcQueue {
  id          String   @id @default(cuid())
  orgId       String
  sfdcQueueId String   // SFDC Queue ID (00G...)
  name        String
  isLicensed  Boolean  @default(false) // whether queue can receive routed records
  syncedAt    DateTime @default(now())

  org               Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  routingRules      RoutingRule[]
  branchAssignments RoutingBranch[] @relation("BranchAssigneeQueue")
  defaultOwnerRules RoutingRule[]   @relation("DefaultOwnerQueue")

  @@unique([orgId, sfdcQueueId])
  @@map("sfdc_queues")
}

model FieldSchema {
  id             String         @id @default(cuid())
  orgId          String
  objectType     CrmObjectType
  fieldApiName   String
  fieldLabel     String
  fieldType      String // TEXT | NUMBER | DATE | DATETIME | BOOLEAN | PICKLIST | MULTI_PICKLIST | LOOKUP
  picklistValues Json?  // string[] for picklist/multi-picklist fields
  syncedAt       DateTime       @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, objectType, fieldApiName])
  @@map("field_schemas")
}

model BillingInfo {
  id           String   @id @default(cuid())
  orgId        String   @unique
  entityName   String?
  gstin        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  pinCode      String?
  invoiceEmail String?
  updatedAt    DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("billing_info")
}

model Session {
  id        String   @id @default(cuid())
  orgId     String
  userId    String   // SFDC User ID of the logged-in admin
  userName  String
  userEmail String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([orgId])
  @@map("sessions")
}

model RoutingDailyAggregate {
  id             String          @id @default(cuid())
  orgId          String
  date           DateTime        @db.Date
  ruleId         String?
  pathLabel      String?
  branchId       String?
  teamId         String?
  assigneeId     String?
  objectType     CrmObjectType?
  successCount   Int             @default(0)
  failedCount    Int             @default(0)
  unmatchedCount Int             @default(0)
  mergedCount    Int             @default(0)
  totalCount     Int             @default(0)
  avgDurationMs  Float?
  minDurationMs  Int?
  maxDurationMs  Int?
  p50DurationMs  Int?
  p95DurationMs  Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, date, ruleId, pathLabel, branchId, teamId, assigneeId, objectType])
  @@index([orgId, date])
  @@map("routing_daily_aggregates")
}

model ConversionTracking {
  id                   String    @id @default(cuid())
  orgId                String
  routingLogId         String    @unique
  crmRecordId          String
  isConverted          Boolean   @default(false)
  convertedAt          DateTime?
  opportunityId        String?
  opportunityAmount    Float?
  opportunityStageName String?
  ruleId               String?
  ruleName             String?
  pathLabel            String?
  teamId               String?
  assigneeId           String?
  assigneeName         String?
  lastCheckedAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  routingLog RoutingLog   @relation(fields: [routingLogId], references: [id], onDelete: Cascade)

  @@index([orgId, isConverted])
  @@index([orgId, crmRecordId])
  @@map("conversion_tracking")
}

model CompanyAlias {
  id          String   @id @default(cuid())
  orgId       String
  nameA       String   // normalized company name A (alphabetically first)
  nameB       String   // normalized company name B
  isSimilar   Boolean  // LLM determination
  confidence  Float?   // LLM confidence score (0-1)
  source      String   @default("AI") // "AI" | "MANUAL" | "DICTIONARY"
  hitCount    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, nameA, nameB])
  @@index([orgId, nameA])
  @@index([orgId, nameB])
  @@map("company_aliases")
}

model BulkSearchRun {
  id               String    @id @default(cuid())
  orgId            String
  ruleId           String
  status           String    @default("RUNNING") // RUNNING | COMPLETE | FAILED | CANCELLED
  recordsFound     Int       @default(0)
  recordsProcessed Int       @default(0)
  recordsRouted    Int       @default(0)
  recordsFailed    Int       @default(0)
  recordsSkipped   Int       @default(0)
  error            String?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  durationMs       Int?
  maxRecords       Int?
  batchSize        Int?

  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rule             RoutingRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([orgId, ruleId])
  @@index([ruleId, status])
  @@map("bulk_search_runs")
}

model ApiToken {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  tokenHash  String    @unique
  prefix     String
  scopes     String[]  @default(["read", "route"])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("api_tokens")
}

model AiCustomPrompt {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type      String   // "instruction" | "template" | "alias" | "memory"
  name      String
  content   String
  context   String?  // null = global, "license-users" | "teams" | "routing-rules"
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, type, isActive])
  @@map("ai_custom_prompts")
}

model AiAgentLog {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  context     String
  toolName    String
  action      String
  entityType  String
  entityId    String?
  entityName  String?
  input       Json
  output      Json?
  status      String
  error       String?
  actorId     String
  actorName   String
  durationMs  Int?
  createdAt   DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, context])
  @@map("ai_agent_logs")
}

model AiChatFeedback {
  id           String   @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rating       String
  userMessage  String
  aiResponse   String
  toolsUsed    Json?
  context      String?
  feedback     String?
  createdAt    DateTime @default(now())

  @@index([orgId, rating])
  @@map("ai_chat_feedback")
}

model SlaPolicy {
  id                    String          @id @default(cuid())
  orgId                 String
  name                  String
  deadlineMinutes       Int             // e.g., 15
  metCriteria           SlaMetCriteria  @default(ANY_ACTIVITY)
  metTargetValue        String?         // For SPECIFIC_STATUS: target value
  breachAction          String          @default("REROUTE") // REROUTE | NOTIFY_ONLY
  maxReroutes           Int             @default(3) // Circuit breaker
  // Business hours (V1 — org-level, prevents midnight loops)
  enforceBusinessHours  Boolean         @default(false)
  businessHoursStart    String?         // "09:00"
  businessHoursEnd      String?         // "18:00"
  businessTimezone      String?         // "America/New_York"
  businessDays          String?         // "1,2,3,4,5" (Mon-Fri)
  isActive              Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  org                   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ruleAssignments       SlaRuleAssignment[]
  instances             SlaInstance[]

  @@unique([orgId, name])
  @@map("sla_policies")
}

model SlaRuleAssignment {
  id          String        @id @default(cuid())
  slaPolicyId String
  ruleId      String?       // Apply to entire rule
  teamId      String?       // Apply to specific team
  branchId    String?       // Apply to specific branch/path

  slaPolicy   SlaPolicy     @relation(fields: [slaPolicyId], references: [id], onDelete: Cascade)
  rule        RoutingRule?   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  team        RoundRobinTeam? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  branch      RoutingBranch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([slaPolicyId, ruleId, teamId, branchId])
  @@map("sla_rule_assignments")
}

model SlaInstance {
  id              String            @id @default(cuid())
  orgId           String
  slaPolicyId     String
  routingLogId    String            @unique
  crmRecordId     String
  objectType      CrmObjectType
  assigneeId      String            // CRM user/owner ID
  ruleId          String?           // Which rule triggered this
  status          SlaInstanceStatus @default(ACTIVE)
  startedAt       DateTime
  deadline        DateTime
  metAt           DateTime?
  breachedAt      DateTime?
  responseTimeMs  Int?              // metAt - startedAt
  breachAction    String?           // What was done on breach
  reassignedTo    String?           // New owner after re-route
  rerouteCount    Int               @default(0) // For circuit breaker
  lastAttemptAt   DateTime?         // When sweeper last attempted breach processing (v2.1)
  attemptCount    Int               @default(0) // Failed re-route attempt count (v2.1)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  org             Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  slaPolicy       SlaPolicy         @relation(fields: [slaPolicyId], references: [id], onDelete: Cascade)
  routingLog      RoutingLog        @relation(fields: [routingLogId], references: [id], onDelete: Cascade)

  @@index([status, deadline])             // Sweeper query
  @@index([orgId, status])                // Per-org active count
  @@index([orgId, crmRecordId, status])   // Webhook lookup + circuit breaker count
  @@index([orgId, slaPolicyId, status])   // Compliance reporting
  @@map("sla_instances")
}

model ToolCallLog {
  id            String   @id @default(cuid())
  orgId         String
  tokenId       String
  tool          String
  category      String
  status        String
  errorCode     String?
  durationMs    Int
  inputHash     String
  responseSize  Int
  crmType       String
  warnings      String[]
  createdAt     DateTime @default(now())

  org           Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@index([orgId, tool])
  @@index([tokenId, createdAt])
  @@map("tool_call_logs")
}
