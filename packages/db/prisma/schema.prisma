generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum SfdcObjectType {
  LEAD
  CONTACT
  ACCOUNT
}

enum TriggerEvent {
  INSERT
  UPDATE
  BOTH
  SEARCH
}

enum RouteType {
  REALTIME
  SCHEDULED
}

enum RuleStatus {
  ACTIVE
  INACTIVE
}

enum AssignmentType {
  USER
  ROUND_ROBIN
  QUEUE
}

enum TeamMemberStatus {
  ACTIVE
  PAUSED
}

enum RoutingStatus {
  SUCCESS
  FAILED
  UNMATCHED
  RETRY
  MERGED
  COOLDOWN_SKIPPED
  STAMP_SKIPPED
}

enum LeadMatchAction {
  SFDC_MERGE
  ASSIGN_TO_OWNER
  ASSIGN_CUSTOM
}

enum ContactMatchAction {
  ASSIGN_TO_OWNER
  ASSIGN_CUSTOM
  SKIP
}

enum AccountMatchAction {
  ASSIGN_TO_OWNER
  ASSIGN_CUSTOM
  SKIP
}

enum Plan {
  FREE
  PAID
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Organization {
  id                String   @id @default(cuid())
  sfdcOrgId         String?  @unique   // null until CRM is connected in onboarding
  sfdcInstanceUrl   String?            // null until CRM is connected
  oauthAccessToken  String?            // null until CRM is connected
  oauthRefreshToken String?            // null until CRM is connected
  webhookSecret     String   // HMAC secret for verifying Apex trigger payloads
  // Integration / package deploy tracking
  packageDeployedAt DateTime?
  packageDeployId   String?
  packageVersion    String?
  objectConfig      Json?              // e.g. { "Lead": { enabled: true }, "Contact": { enabled: true } }
  fieldsSyncedAt    DateTime?
  plan             Plan     @default(FREE)
  isActive         Boolean  @default(true)
  seatsPurchased    Int      @default(5)
  seatsUsed         Int      @default(0)
  routingQuotaUsed Int      @default(0)
  quotaResetAt     DateTime @default(now())
  onboardingDone           Boolean  @default(false)
  notificationWebhookUrl   String?
  // AI Assistant (Pro feature)
  aiProvider       String?   // "claude" | "openai" | "gemini" | "custom"
  aiApiKey         String?   // AES-256-GCM encrypted
  aiModelName      String?   // e.g. "claude-sonnet-4-5-20250514", "gpt-4o"
  aiBaseUrl        String?   // custom endpoint URL (null = default)
  aiCustomHeaders  Json?     // custom headers for self-hosted proxies
  aiChatCount      Int       @default(0)
  // License activation (from web UI)
  licenseKey         String?
  licenseTier        String?   // "free" | "pro"
  licenseValidUntil  DateTime?
  licenseActivatedAt DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  users        User[]
  appUsers     AppUser[]
  invites      Invite[]
  teams        RoundRobinTeam[]
  routingRules RoutingRule[]
  routingLogs  RoutingLog[]
  auditLogs    AuditLog[]
  sfdcQueues   SfdcQueue[]
  fieldSchemas FieldSchema[]
  billingInfo             BillingInfo?
  routingDailyAggregates  RoutingDailyAggregate[]
  conversionTracking      ConversionTracking[]
  companyAliases          CompanyAlias[]

  @@map("organizations")
}

model AppUser {
  id           String   @id @default(cuid())
  orgId        String
  email        String
  name         String
  passwordHash String   // PBKDF2: "salt:hash" (salt=16-byte hex, 310000 iterations, sha256)
  role         String   @default("ADMIN") // ADMIN | MEMBER
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@map("app_users")
}

model Invite {
  id         String    @id @default(cuid())
  orgId      String
  email      String
  token      String    @unique // 48-char hex (crypto.randomBytes(24))
  expiresAt  DateTime           // 72 hours from creation
  acceptedAt DateTime?          // null until invite is used
  createdAt  DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("invites")
}

model User {
  id           String    @id @default(cuid())
  orgId        String
  sfdcUserId   String
  name         String
  email        String
  role         String?
  profile      String?
  department   String?
  isLicensed   Boolean   @default(false)
  licensedVia  String?   // "individual" | "role" | "profile" | "custom_field" — how user was licensed
  isActive     Boolean   @default(true) // false if no longer in SFDC
  lastRoutedAt DateTime?
  syncedAt     DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org              Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teamMemberships  TeamMember[]
  branchAssignments RoutingBranch[] @relation("BranchAssigneeUser")
  defaultOwnerRules RoutingRule[]   @relation("DefaultOwnerUser")

  @@unique([orgId, sfdcUserId])
  @@map("users")
}

model RoundRobinTeam {
  id           String   @id @default(cuid())
  orgId        String
  name         String
  description      String?
  distributionType String   @default("round-robin") // "round-robin" | "weighted"
  pointerIndex     Int      @default(0) // kept in sync with Redis; Redis is authoritative
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org               Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members           TeamMember[]
  routingRules      RoutingRule[]   @relation("TeamRules")
  branchAssignments RoutingBranch[] @relation("BranchAssigneeTeam")
  defaultOwnerRules RoutingRule[]   @relation("DefaultOwnerTeam")

  @@map("round_robin_teams")
}

model TeamMember {
  id              String           @id @default(cuid())
  teamId          String
  userId          String
  status          TeamMemberStatus @default(ACTIVE)
  weight          Int              @default(1) // P2 weighted round robin
  assignmentCount Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  team RoundRobinTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model RoutingRule {
  id               String          @id @default(cuid())
  orgId            String
  objectType       SfdcObjectType
  triggerEvent     TriggerEvent
  name             String
  priority         Int
  status           RuleStatus      @default(ACTIVE)
  // Legacy single-assignee fields (used by old rules; null for new Route Builder rules)
  assignmentType   AssignmentType?
  assigneeUserId   String?         // references User.id (individual user)
  assigneeTeamId   String?         // references RoundRobinTeam.id
  assigneeQueueId  String?         // references SfdcQueue.id
  isDryRun         Boolean         @default(false)
  triggerName      String          @default("")
  criteriaSyncedAt DateTime?
  // Route type (real-time Apex trigger vs scheduled search)
  routeType         RouteType       @default(REALTIME)
  // Scheduled route fields
  scheduleFrequency String?         // "DAILY" | "WEEKLY" | "MONTHLY" | null (one-time)
  scheduleTime      String?         // "06:00" (24h format)
  scheduleTimezone  String?         // "UTC", "US/Eastern", etc.
  scheduleCron      String?         // computed cron expression for BullMQ
  searchCriteria    Json?           // ConditionGroup[] — search trigger criteria
  lastRunAt         DateTime?
  lastRunStatus     String?         // "SUCCESS" | "FAILED" | "PARTIAL"
  lastRunRecords    Int?            // records routed in last run
  lastRunDurationMs Int?
  totalRuns         Int             @default(0)
  totalRecordsRouted Int            @default(0)
  // Default owner: absolute catch-all for new Route Builder routes
  defaultOwnerType     AssignmentType?
  defaultOwnerUserId   String?
  defaultOwnerTeamId   String?
  defaultOwnerQueueId  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  org              Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team             RoundRobinTeam?  @relation("TeamRules", fields: [assigneeTeamId], references: [id])
  queue            SfdcQueue?       @relation(fields: [assigneeQueueId], references: [id])
  defaultOwnerUser  User?           @relation("DefaultOwnerUser", fields: [defaultOwnerUserId], references: [id])
  defaultOwnerTeam  RoundRobinTeam? @relation("DefaultOwnerTeam", fields: [defaultOwnerTeamId], references: [id])
  defaultOwnerQueue SfdcQueue?      @relation("DefaultOwnerQueue", fields: [defaultOwnerQueueId], references: [id])
  conditions RuleCondition[]  // legacy conditions (old-style rules)
  branches   RoutingBranch[]  // new Route Builder paths
  matchConfig RouteMatchConfig?
  triggerConditions TriggerCondition[]

  @@map("routing_rules")
}

model RoutingBranch {
  id              String         @id @default(cuid())
  ruleId          String
  rule            RoutingRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  label           String?
  priority        Int            @default(0)
  assignmentType  AssignmentType?
  assigneeUserId  String?
  assigneeUser    User?            @relation("BranchAssigneeUser", fields: [assigneeUserId], references: [id])
  assigneeTeamId  String?
  assigneeTeam    RoundRobinTeam?  @relation("BranchAssigneeTeam", fields: [assigneeTeamId], references: [id])
  assigneeQueueId String?
  assigneeQueue   SfdcQueue?       @relation("BranchAssigneeQueue", fields: [assigneeQueueId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  conditions  BranchCondition[]
  routingLogs RoutingLog[]

  @@map("routing_branches")
}

model BranchCondition {
  id        String        @id @default(cuid())
  branchId  String
  branch    RoutingBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  groupId   String
  fieldName String
  fieldType String        @default("TEXT")
  operator  String
  value     String?
  sortOrder Int           @default(0)

  @@map("branch_conditions")
}

model TriggerCondition {
  id        String      @id @default(cuid())
  ruleId    String
  rule      RoutingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  groupId   String
  fieldName String
  fieldType String      @default("TEXT")
  operator  String
  value     String?
  sortOrder Int         @default(0)

  @@map("trigger_conditions")
}

model RouteMatchConfig {
  id              String      @id @default(cuid())
  ruleId          String      @unique
  rule            RoutingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  // Which objects to check
  checkLeads      Boolean     @default(true)
  checkContacts   Boolean     @default(true)
  checkAccounts   Boolean     @default(false)

  // Which fields to match on
  matchEmail      Boolean     @default(true)
  matchPhone      Boolean     @default(false)
  matchDomain     Boolean     @default(false)
  matchCompanyName  Boolean @default(false)
  fuzzyMatchMode    String  @default("STRICT")  // "STRICT" | "FUZZY" | "AI_SMART"

  // Lead match outcome
  onLeadMatch           LeadMatchAction    @default(SFDC_MERGE)
  leadAssignmentType    AssignmentType?
  leadAssigneeUserId    String?
  leadAssigneeTeamId    String?
  leadAssigneeQueueId   String?

  // Contact match outcome
  onContactMatch        ContactMatchAction @default(ASSIGN_TO_OWNER)
  contactAssignmentType AssignmentType?
  contactAssigneeUserId  String?
  contactAssigneeTeamId  String?
  contactAssigneeQueueId String?

  // Account match outcome
  onAccountMatch        AccountMatchAction @default(ASSIGN_TO_OWNER)
  accountAssignmentType AssignmentType?
  accountAssigneeUserId  String?
  accountAssigneeTeamId  String?
  accountAssigneeQueueId String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("route_match_configs")
}

model RuleCondition {
  id          String @id @default(cuid())
  ruleId      String
  groupId     String // conditions in same group share AND logic; groups are joined with OR
  fieldName   String // SFDC field API name (e.g., "LeadSource")
  operator    String // e.g., "equals", "contains", "gt"
  value       String? // null for is_blank / is_not_blank / is_true / is_false
  sortOrder   Int    @default(0)

  rule RoutingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@map("rule_conditions")
}

model RoutingLog {
  id             String          @id @default(cuid())
  orgId          String
  sfdcRecordId   String
  objectType     SfdcObjectType
  eventType      TriggerEvent
  ruleId         String?
  ruleName       String?
  pathLabel      String?  // which branch/path triggered: e.g. "Path A" or "Default Owner"
  assigneeId     String?  // SFDC user/queue ID
  assigneeName   String?
  assignmentType AssignmentType?
  isDryRun        Boolean         @default(false)
  status          RoutingStatus
  errorMessage    String?
  retryCount      Int             @default(0)
  dismissed       Boolean         @default(false)
  recordSnapshot  Json?           // full field payload from SFDC at time of routing
  decisionTrace   Json?           // structured routing decision trace for Record Journey
  teamId             String?
  teamName           String?
  routingDurationMs  Int?              // ms from webhook receipt → SFDC assignment
  branchId           String?           // FK → RoutingBranch for path-level analytics
  createdAt          DateTime        @default(now())

  org                Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branch             RoutingBranch?  @relation(fields: [branchId], references: [id])
  conversionTracking ConversionTracking?

  @@index([orgId, createdAt])
  @@index([orgId, status])
  @@index([orgId, teamId])
  @@index([orgId, ruleId])
  @@index([orgId, sfdcRecordId, createdAt])
  @@map("routing_logs")
}

model AuditLog {
  id          String   @id @default(cuid())
  orgId       String
  actorId     String   // User.id
  actorName   String
  action      String   // e.g., "USER_LICENSED", "RULE_CREATED"
  entityType  String   // e.g., "User", "RoutingRule"
  entityId    String
  beforeState Json?
  afterState  Json?
  createdAt   DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@map("audit_logs")
}

model SfdcQueue {
  id          String   @id @default(cuid())
  orgId       String
  sfdcQueueId String   // SFDC Queue ID (00G...)
  name        String
  isLicensed  Boolean  @default(false) // whether queue can receive routed records
  syncedAt    DateTime @default(now())

  org               Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  routingRules      RoutingRule[]
  branchAssignments RoutingBranch[] @relation("BranchAssigneeQueue")
  defaultOwnerRules RoutingRule[]   @relation("DefaultOwnerQueue")

  @@unique([orgId, sfdcQueueId])
  @@map("sfdc_queues")
}

model FieldSchema {
  id             String         @id @default(cuid())
  orgId          String
  objectType     SfdcObjectType
  fieldApiName   String
  fieldLabel     String
  fieldType      String // TEXT | NUMBER | DATE | DATETIME | BOOLEAN | PICKLIST | MULTI_PICKLIST | LOOKUP
  picklistValues Json?  // string[] for picklist/multi-picklist fields
  syncedAt       DateTime       @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, objectType, fieldApiName])
  @@map("field_schemas")
}

model BillingInfo {
  id           String   @id @default(cuid())
  orgId        String   @unique
  entityName   String?
  gstin        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  pinCode      String?
  invoiceEmail String?
  updatedAt    DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("billing_info")
}

model Session {
  id        String   @id @default(cuid())
  orgId     String
  userId    String   // SFDC User ID of the logged-in admin
  userName  String
  userEmail String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([orgId])
  @@map("sessions")
}

model RoutingDailyAggregate {
  id             String          @id @default(cuid())
  orgId          String
  date           DateTime        @db.Date
  ruleId         String?
  pathLabel      String?
  branchId       String?
  teamId         String?
  assigneeId     String?
  objectType     SfdcObjectType?
  successCount   Int             @default(0)
  failedCount    Int             @default(0)
  unmatchedCount Int             @default(0)
  mergedCount    Int             @default(0)
  totalCount     Int             @default(0)
  avgDurationMs  Float?
  minDurationMs  Int?
  maxDurationMs  Int?
  p50DurationMs  Int?
  p95DurationMs  Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, date, ruleId, pathLabel, branchId, teamId, assigneeId, objectType])
  @@index([orgId, date])
  @@map("routing_daily_aggregates")
}

model ConversionTracking {
  id                   String    @id @default(cuid())
  orgId                String
  routingLogId         String    @unique
  sfdcLeadId           String
  isConverted          Boolean   @default(false)
  convertedAt          DateTime?
  opportunityId        String?
  opportunityAmount    Float?
  opportunityStageName String?
  ruleId               String?
  ruleName             String?
  pathLabel            String?
  teamId               String?
  assigneeId           String?
  assigneeName         String?
  lastCheckedAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  routingLog RoutingLog   @relation(fields: [routingLogId], references: [id], onDelete: Cascade)

  @@index([orgId, isConverted])
  @@index([orgId, sfdcLeadId])
  @@map("conversion_tracking")
}

model CompanyAlias {
  id          String   @id @default(cuid())
  orgId       String
  nameA       String   // normalized company name A (alphabetically first)
  nameB       String   // normalized company name B
  isSimilar   Boolean  // LLM determination
  confidence  Float?   // LLM confidence score (0-1)
  source      String   @default("AI") // "AI" | "MANUAL" | "DICTIONARY"
  hitCount    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, nameA, nameB])
  @@index([orgId, nameA])
  @@index([orgId, nameB])
  @@map("company_aliases")
}
